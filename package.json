{
  "name": "@local/dsh-screenshot",
  "version": "1.0.0",
  "type": "module",
  "description": "在对话输入框添加截屏按钮，框选屏幕后作为图片附件插入 Draft。 Windows only.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "screenshot",
    "capture",
    "windows"
  ],
  "author": "34394",
  "license": "MIT",
  "os": [
    "win32"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "capture.ps1",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs",
    "README.md",
    "README.zh.md",
    "market"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
